# 复制为仓库根目录的 .env。Vite 只在启动时读取；改完后要重新运行 pnpm dev。
# Copy to .env at the repo root. Vite reads it at startup; restart `pnpm dev` after edits.
# 不要在这里写 API Key、代理、资料库路径或 PIN。那些属于本机 library-config.cfg，且已被 gitignore。

# true：页面走 Go HTTP API。false、留空或删掉这一行：使用浏览器内 Mock，不需要后端。
# true: use the Go HTTP API. false, empty, or omit: in-browser Mock, no backend required.
VITE_USE_WEB_API=true

# 可选。不设置时，本机 pnpm dev 且上面为 true，会直连 http://127.0.0.1:8080/api。
# 只有要连别的 Curated Server 时才取消注释，例如 http://127.0.0.1:8081/api。
# Optional. Unset means local dev talks to http://127.0.0.1:8080/api.
# VITE_API_BASE_URL=

# 可选的浏览器日志级别：trace | debug | info | warn | error | silent。
# localStorage 键 curated-client-log-level 优先于这里。
# Optional browser log level. localStorage curated-client-log-level wins.
# VITE_LOG_LEVEL=debug
