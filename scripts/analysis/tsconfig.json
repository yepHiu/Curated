{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["vite/client"],
    "baseUrl": "../..",
    "paths": { "@/*": ["src/*"] }
  },
  "include": ["app/**/*.ts", "app/**/*.vue", "app/**/*.mts"]
}
